+    /// Creates a classic 2D resource. The default component gets it first; when that component
+    /// cannot (virglrenderer built for venus only, as on macOS, rejects 2D creation with EINVAL),
+    /// the 2D component owns it so dumb-buffer scanouts still reach the display.
+    pub fn resource_create_2d(
+        &mut self,
+        resource_id: u32,
+        resource_create_3d: ResourceCreate3D,
+    ) -> RutabagaResult<()> {
+        let default_result = self.resource_create_3d(resource_id, resource_create_3d);
+        if default_result.is_ok() || self.default_component == RutabagaComponentType::Rutabaga2D {
+            return default_result;
+        }
+        if self.resources.contains_key(&resource_id) {
+            return default_result;
+        }
+
+        let component = self
+            .components
+            .get_mut(&RutabagaComponentType::Rutabaga2D)
+            .ok_or(RutabagaError::InvalidComponent)?;
+        let resource = component.create_3d(resource_id, resource_create_3d)?;
+        self.resources.insert(resource_id, resource);
+        Ok(())
+    }
+
+    fn component_for_resource(&self, resource_id: u32) -> RutabagaComponentType {
+        let only_2d = 1 << (RutabagaComponentType::Rutabaga2D as u8);
+        match self.resources.get(&resource_id) {
+            Some(resource) if resource.component_mask == only_2d => {
+                RutabagaComponentType::Rutabaga2D
+            }
+            _ => self.default_component,
+        }
+    }
