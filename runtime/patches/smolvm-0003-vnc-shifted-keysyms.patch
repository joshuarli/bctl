@@ -606,7 +609,7 @@ pub fn keysym_to_evdev(keysym: u32) -> Option<u16> {
         0xffc8 => 87,
         0xffc9 => 88, // F9-F12
         // Modifiers.
-        0xffe1 => 42,  // Shift_L
+        0xffe1 => KEY_LEFT_SHIFT, // Shift_L
         0xffe2 => 54,  // Shift_R
         0xffe3 => 29,  // Control_L
         0xffe4 => 97,  // Control_R
@@ -619,6 +622,37 @@ pub fn keysym_to_evdev(keysym: u32) -> Option<u16> {
