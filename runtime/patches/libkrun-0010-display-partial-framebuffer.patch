+            st.width = 0;
+            st.height = 0;
+            st.format = None;
+            st.staging.clear();
+            st.front.clear();
+            self.frame_buf.clear();
+            Ok(())
+        }
+
+        fn alloc_frame(
+            &mut self,
+            _scanout_id: u32,
+        ) -> std::result::Result<(u32, &mut [u8]), DisplayBackendError> {
+            let st = self.state.lock().unwrap();
+            if st.zero_on_alloc {
+                self.frame_buf.fill(0);
+            }
+            Ok((0, &mut self.frame_buf[..]))
+        }
+
+        fn present_frame(
+            &mut self,
+            _scanout_id: u32,
+            _frame_id: u32,
+            rect: Option<&Rect>,
+        ) -> std::result::Result<(), DisplayBackendError> {
+            let mut st = self.state.lock().unwrap();
+            st.staging.copy_from_slice(&self.frame_buf);
+            let stride = (st.width * 4) as usize;
+            match rect {
+                Some(r) => {
+                    for row in r.y..r.y + r.height {
+                        let start = row as usize * stride + (r.x * 4) as usize;
+                        let end = start + (r.width * 4) as usize;
+                        st.front[start..end].copy_from_slice(&self.frame_buf[start..end]);
+                    }
+                    st.presents.push(Some((r.x, r.y, r.width, r.height)));
+                }
+                None => {
+                    st.front.copy_from_slice(&self.frame_buf);
+                    st.presents.push(None);
+                }
+            }
+            Ok(())
+        }
+    }
