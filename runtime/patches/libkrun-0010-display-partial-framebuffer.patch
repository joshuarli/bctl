+    #[test]
+    fn alternating_two_buffer_scanout_reads_and_presents_bounded_damage() {
+        let (w, h) = (16u32, 16u32);
+        let len = (w * h * 4) as usize;
+        let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), 0x20000)]).unwrap();
+        let state = Arc::new(Mutex::new(MockDisplayState::default()));
+        let mut gpu = make_2d_test_gpu(
+            ParticipatingMockBackend::into_display_backend(Some(&state)),
+            w,
+            h,
+        );
+
+        let gpa1 = 0x1000u64;
+        let gpa2 = 0x5000u64;
+        create_2d_resource(&mut gpu, &mem, 1, gpa1, w, h);
+        create_2d_resource(&mut gpu, &mem, 2, gpa2, w, h);
+
+        let full = Rect { x: 0, y: 0, width: w, height: h };
+        let mut buf1 = vec![0u8; len];
+        let mut buf2 = vec![0u8; len];
+        let mut expected = vec![0u8; len];
+
+        paint_rect(&mut buf1, &mem, gpa1, w, full, [10, 20, 30, 255]);
+        expected.copy_from_slice(&buf1);
+        gpu.transfer_write(0, 1, Transfer3D::new_2d(0, 0, w, h)).unwrap();
+        gpu.set_scanout(0, 1, w, h).unwrap();
+        gpu.flush_resource(1, full).unwrap();
+        assert_eq!(gpu.damage_stats().full_reads, 1);
+        assert_eq!(gpu.damage_stats().partial_reads, 0);
+        assert_eq!(gpu.damage_stats().scanouts_presented, 1);
+        assert_eq!(state.lock().unwrap().front, expected);
+
+        buf2.copy_from_slice(&buf1);
+        let rect_a = Rect { x: 2, y: 2, width: 4, height: 4 };
+        paint_rect(&mut buf2, &mem, gpa2, w, full, [10, 20, 30, 255]);
+        paint_rect(&mut buf2, &mem, gpa2, w, rect_a, [40, 50, 60, 255]);
+        expected.copy_from_slice(&buf2);
+        gpu.transfer_write(0, 2, Transfer3D::new_2d(0, 0, w, h)).unwrap();
+        gpu.set_scanout(0, 2, w, h).unwrap();
+        gpu.flush_resource(2, rect_a).unwrap();
+        assert_eq!(gpu.damage_stats().full_reads, 2);
+        assert_eq!(gpu.damage_stats().partial_reads, 0);
+        assert_eq!(gpu.damage_stats().scanouts_presented, 2);
+        assert_eq!(state.lock().unwrap().front, expected);
+
+        let rect_b = Rect { x: 8, y: 6, width: 3, height: 5 };
+        paint_rect(&mut buf1, &mem, gpa1, w, rect_a, [40, 50, 60, 255]);
+        paint_rect(&mut buf1, &mem, gpa1, w, rect_b, [70, 80, 90, 255]);
+        expected.copy_from_slice(&buf1);
+        let union_ab = rect_union(rect_a, rect_b);
+        gpu.transfer_write(
+            0,
+            1,
+            Transfer3D::new_2d(union_ab.x, union_ab.y, union_ab.width, union_ab.height),
+        )
+        .unwrap();
+        gpu.set_scanout(0, 1, w, h).unwrap();
+        gpu.flush_resource(1, rect_b).unwrap();
+        assert_eq!(gpu.damage_stats().full_reads, 2);
+        assert_eq!(gpu.damage_stats().partial_reads, 1);
+        assert_eq!(gpu.damage_stats().scanouts_presented, 3);
+        assert_eq!(
+            state.lock().unwrap().presents.last(),
+            Some(&Some((union_ab.x, union_ab.y, union_ab.width, union_ab.height)))
+        );
+        assert_eq!(state.lock().unwrap().front, expected);
+
+        let rect_c = Rect { x: 12, y: 12, width: 2, height: 2 };
+        paint_rect(&mut buf2, &mem, gpa2, w, rect_b, [70, 80, 90, 255]);
+        paint_rect(&mut buf2, &mem, gpa2, w, rect_c, [100, 110, 120, 255]);
+        expected.copy_from_slice(&buf2);
+        gpu.transfer_write(
+            0,
+            2,
+            Transfer3D::new_2d(rect_b.x, rect_b.y, rect_b.width, rect_b.height),
+        )
+        .unwrap();
+        gpu.transfer_write(
+            0,
+            2,
+            Transfer3D::new_2d(rect_c.x, rect_c.y, rect_c.width, rect_c.height),
+        )
+        .unwrap();
+        gpu.set_scanout(0, 2, w, h).unwrap();
+        gpu.flush_resource(2, rect_c).unwrap();
+        assert_eq!(gpu.damage_stats().full_reads, 2);
+        assert_eq!(gpu.damage_stats().partial_reads, 2);
+        assert_eq!(gpu.damage_stats().scanouts_presented, 4);
+        assert_eq!(state.lock().unwrap().front, expected);
+
+        let rect_d = Rect { x: 13, y: 13, width: 2, height: 2 };
+        paint_rect(&mut buf1, &mem, gpa1, w, rect_c, [100, 110, 120, 255]);
+        paint_rect(&mut buf1, &mem, gpa1, w, rect_d, [200, 210, 220, 255]);
+        expected.copy_from_slice(&buf1);
+        gpu.transfer_write(
+            0,
+            1,
+            Transfer3D::new_2d(rect_c.x, rect_c.y, rect_c.width, rect_c.height),
+        )
+        .unwrap();
+        gpu.transfer_write(
+            0,
+            1,
+            Transfer3D::new_2d(rect_d.x, rect_d.y, rect_d.width, rect_d.height),
+        )
+        .unwrap();
+        gpu.set_scanout(0, 1, w, h).unwrap();
+        gpu.flush_resource(1, rect_d).unwrap();
+        let last_rect = state.lock().unwrap().presents.last().copied().flatten().unwrap();
+        assert!(last_rect.0 >= 8 && last_rect.1 >= 6);
+        assert_eq!(state.lock().unwrap().front, expected);
+    }
+
+    #[test]
+    fn non_participating_backend_falls_back_to_full_reads() {
+        let (w, h) = (8u32, 8u32);
+        let len = (w * h * 4) as usize;
+        let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), 0x10000)]).unwrap();
+        let state = Arc::new(Mutex::new(MockDisplayState {
+            zero_on_alloc: true,
+            ..Default::default()
+        }));
+        let mut gpu = make_2d_test_gpu(
+            NonParticipatingMockBackend::into_display_backend(Some(&state)),
+            w,
+            h,
+        );
+        create_2d_resource(&mut gpu, &mem, 1, 0x1000, w, h);
+
+        let full = Rect { x: 0, y: 0, width: w, height: h };
+        let mut buf = vec![0u8; len];
+        paint_rect(&mut buf, &mem, 0x1000, w, full, [1, 2, 3, 255]);
+        gpu.transfer_write(0, 1, Transfer3D::new_2d(0, 0, w, h)).unwrap();
+        gpu.set_scanout(0, 1, w, h).unwrap();
+        gpu.flush_resource(1, full).unwrap();
+
+        let sub = Rect { x: 2, y: 2, width: 2, height: 2 };
+        paint_rect(&mut buf, &mem, 0x1000, w, sub, [9, 8, 7, 255]);
+        gpu.transfer_write(0, 1, Transfer3D::new_2d(2, 2, 2, 2)).unwrap();
+        gpu.flush_resource(1, sub).unwrap();
+
+        assert_eq!(gpu.damage_stats().full_reads, 2);
+        assert_eq!(gpu.damage_stats().partial_reads, 0);
+        assert_eq!(state.lock().unwrap().presents, vec![None, None]);
+        assert_eq!(state.lock().unwrap().front, buf);
+    }
+
+    #[test]
+    fn disable_scanout_resets_partial_history() {
+        let (w, h) = (8u32, 8u32);
+        let len = (w * h * 4) as usize;
+        let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), 0x10000)]).unwrap();
+        let state = Arc::new(Mutex::new(MockDisplayState::default()));
+        let mut gpu = make_2d_test_gpu(
+            ParticipatingMockBackend::into_display_backend(Some(&state)),
+            w,
+            h,
+        );
+        create_2d_resource(&mut gpu, &mem, 1, 0x1000, w, h);
+
+        let full = Rect { x: 0, y: 0, width: w, height: h };
+        let sub = Rect { x: 1, y: 1, width: 2, height: 2 };
+        let mut buf = vec![0u8; len];
+        paint_rect(&mut buf, &mem, 0x1000, w, full, [11, 22, 33, 255]);
+        gpu.transfer_write(0, 1, Transfer3D::new_2d(0, 0, w, h)).unwrap();
+        gpu.set_scanout(0, 1, w, h).unwrap();
+
+        paint_rect(&mut buf, &mem, 0x1000, w, sub, [44, 55, 66, 255]);
+        gpu.transfer_write(0, 1, Transfer3D::new_2d(1, 1, 2, 2)).unwrap();
+        gpu.flush_resource(1, sub).unwrap();
+        assert_eq!(gpu.damage_stats().partial_reads, 1);
+
+        gpu.set_scanout(0, 0, 0, 0).unwrap();
+        gpu.transfer_write(0, 1, Transfer3D::new_2d(1, 1, 2, 2)).unwrap();
+        gpu.set_scanout(0, 1, w, h).unwrap();
+        assert_eq!(gpu.damage_stats().full_reads, 2);
+        assert_eq!(state.lock().unwrap().presents.last(), Some(&None));
+        assert_eq!(state.lock().unwrap().front, buf);
+    }
 }
