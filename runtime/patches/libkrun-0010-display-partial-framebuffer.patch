+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct VirtioGpuDamageStats {
+    pub transfer_writes: u64,
+    pub transfer_write_bytes: u64,
+    pub scanouts_presented: u64,
+    pub full_reads: u64,
+    pub partial_reads: u64,
+    pub bytes_read: u64,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct ScanoutConfig {
+    scanout_id: u32,
+    width: u32,
+    height: u32,
+    format: ResourceFormat,
+}
+
+fn rect_clipped(rect: Rect, width: u32, height: u32) -> Option<Rect> {
+    let x2 = rect.x.saturating_add(rect.width).min(width);
+    let y2 = rect.y.saturating_add(rect.height).min(height);
+    (rect.x < x2 && rect.y < y2).then_some(Rect {
+        x: rect.x,
+        y: rect.y,
+        width: x2.saturating_sub(rect.x),
+        height: y2.saturating_sub(rect.y),
+    })
+}
+
+fn rect_union(a: Rect, b: Rect) -> Rect {
+    let x = a.x.min(b.x);
+    let y = a.y.min(b.y);
+    let x2 = a.x.saturating_add(a.width).max(b.x.saturating_add(b.width));
+    let y2 = a.y.saturating_add(a.height).max(b.y.saturating_add(b.height));
+    Rect {
+        x,
+        y,
+        width: x2 - x,
+        height: y2 - y,
+    }
+}
+
+fn rect_is_full(rect: Rect, width: u32, height: u32) -> bool {
+    rect.x == 0 && rect.y == 0 && rect.width >= width && rect.height >= height
+}
+
+fn rect_bytes(rect: Rect) -> u64 {
+    u64::from(rect.width) * u64::from(rect.height) * ResourceFormat::BYTES_PER_PIXEL as u64
+}
