+    fn make_2d_test_gpu(display_backend: DisplayBackend<'_>, width: u32, height: u32) -> VirtioGpu {
+        let rutabaga = RutabagaBuilder::new(RutabagaComponentType::Rutabaga2D, 0, 0)
+            .build(RutabagaFenceHandler::new(|_| {}), None)
+            .unwrap();
+        let display_backend = display_backend.create_instance().unwrap();
+        #[cfg(target_os = "macos")]
+        let (map_sender, _map_rx) = unbounded();
+        VirtioGpu {
+            rutabaga,
+            represent_until: None,
+            last_represent: None,
+            resources: Default::default(),
+            backings: Default::default(),
+            fence_state: Arc::new(Mutex::new(Default::default())),
+            #[cfg(target_os = "macos")]
+            map_sender,
+            scanouts: Default::default(),
+            displays: vec![DisplayInfo::new(width, height)].into_boxed_slice(),
+            display_backend,
+            damage_stats: Default::default(),
+        }
+    }
+
+    fn create_2d_resource(
+        gpu: &mut VirtioGpu,
+        mem: &GuestMemoryMmap,
+        resource_id: u32,
+        gpa: u64,
+        width: u32,
+        height: u32,
+    ) {
+        let info = ResourceCreate3D {
+            target: 2,
+            format: 2,
+            bind: 0,
+            width,
+            height,
+            depth: 1,
+            array_size: 1,
+            last_level: 0,
+            nr_samples: 0,
+            flags: 0,
+        };
+        gpu.resource_create_2d(resource_id, info).unwrap();
+        gpu.attach_backing(
+            resource_id,
+            mem,
+            vec![(GuestAddress(gpa), (width * height * 4) as usize)],
+        )
+        .unwrap();
+    }
+
+    fn paint_rect(
+        buf: &mut [u8],
+        mem: &GuestMemoryMmap,
+        gpa: u64,
+        width: u32,
+        rect: Rect,
+        pixel: [u8; 4],
+    ) {
+        let stride = (width * 4) as usize;
+        for y in rect.y..rect.y + rect.height {
+            for x in rect.x..rect.x + rect.width {
+                let off = y as usize * stride + (x * 4) as usize;
+                buf[off..off + 4].copy_from_slice(&pixel);
+            }
+        }
+        mem.write_slice(buf, GuestAddress(gpa)).unwrap();
+    }
