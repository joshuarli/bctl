+fn verify_archive_digest(
+    reference: &str,
+    archive: &Path,
+    expected: &str,
+    actual: &str,
+) -> Result<()> {
+    if actual != expected {
+        return Err(Error::agent(
+            "resume machine",
+            format!(
+                "the image archive {} for {reference} changed since this machine was paused \
+                 (sha256 {actual}, expected {expected}); restore it or recreate the machine",
+                archive.display()
+            ),
+        ));
+    }
+    Ok(())
+}
